{
  "extends": ["eslint:recommended", "plugin:react/recommended", "plugin:@typescript-eslint/recommended", "plugin:prettier/recommended"],
  "plugins": ["react", "@typescript-eslint", "prettier"],
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "singleQuote": true,      // Prefer single quotes
        "endOfLine": "lf",       // Line endings as LF (for Unix/Mac systems)
        "trailingComma": "es5",  // Add trailing commas where valid in ES5 (e.g., objects, arrays)
        "semi": true             // Enforce semicolons
      }
    ],
    "react/react-in-jsx-scope": "off" // For Next.js, React is automatically imported
  }
}
